services:
  n8n:
    image: {{ apps.n8n.image_repo }}:{{ apps.n8n.image_tag }}
    container_name: {{ apps.n8n.container_name }}
    restart: unless-stopped
    env_file: .env
    volumes:
      - {{ n8n_data_dir }}:/home/node/.n8n
      - ./local-files:/files
    expose:
      - "{{ n8n_port }}"
    networks:
      - proxy

networks:
  proxy:
    external: true
